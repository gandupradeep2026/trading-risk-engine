[flake8]
max-line-length = 120
extend-ignore =
    E203,
    W503,
    E501,
    C901,
    F401,
    F841,
    F541,
    E402,
    W391,
    E301,
    E302,
    E303,
    E305,
    E228
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .pytest_cache,
    build,
    dist,
    *.egg-info,
    terraform,
    .terraform
per-file-ignores =
    __init__.py: F401, F403
max-complexity = 25
